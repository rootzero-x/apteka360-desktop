{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apteka 360",
  "version": "0.1.0",
  "identifier": "uz.agrom24.apteka360.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Apteka 360",
        "url": "index.html",
        "width": 1366,
        "height": 860,
        "minWidth": 1280,
        "minHeight": 800,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": true,
        "zoomHotkeysEnabled": true,
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36 Apteka360Desktop/0.1.0"
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "Apteka 360 — dorixona boshqaruv tizimi",
    "longDescription": "Apteka 360 dorixona tarmog'i boshqaruv tizimining Windows/Linux desktop ilovasi. https://apteka.agrom24.uz web panelini ochadi.",
    "publisher": "Apteka 360",
    "copyright": "© Apteka 360",
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": { "depends": [] },
      "appimage": { "bundleMediaFramework": false }
    }
  },
  "plugins": {}
}
