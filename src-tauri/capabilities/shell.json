{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Native qobiq (ui/index.html) uchun ruxsatlar",
  "windows": [
    "main"
  ],
  "webviews": [
    "shell"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "opener:allow-open-url",
    "allow-check-online",
    "allow-get-client-info",
    "allow-toggle-fullscreen",
    "allow-zoom-step",
    "allow-panel-navigate",
    "allow-panel-reload",
    "allow-panel-back",
    "allow-panel-forward",
    "allow-set-panel-bounds",
    "allow-set-panel-visible",
    "allow-report-network",
    "allow-get-prefs",
    "allow-set-pref",
    "allow-show-about",
    "allow-open-in-browser",
    "allow-quit-app",
    "allow-panel-eval-compact",
    "allow-show-more-menu"
