{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-panel",
  "description": "https://app.apteka360.uz paneliga (child-webview «panel») beriladigan minimal ruxsatlar",
  "windows": [
    "main"
  ],
  "webviews": [
    "panel"
  ],
  "remote": {
    "urls": [
      "https://app.apteka360.uz/*",
      "https://*.apteka360.uz/*",
      "https://apteka.agrom24.uz/*",
      "https://*.agrom24.uz/*"
    ]
  },
  "permissions": [
    "core:event:default",
    "allow-toggle-fullscreen",
    "allow-zoom-step",
    "allow-panel-reload",
    "allow-panel-back",
    "allow-panel-forward",
    "allow-report-network",
    "allow-get-client-info",
    "allow-api-result",
    "allow-report-token",
    "allow-shell-home"
  ]
}